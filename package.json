{
  "name": "ytmp3-next",
  "version": "1.5.0",
  "private": true,
  "productName": "Audit",
  "main": "./dist/main/main.js",
  "author": "<MC/>",
  "description": "YouTube to MP3 Converter",
  "license": "MIT License",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheNotoriousCompa/Audit"
  },
  "scripts": {
    "restart": "pkill -f 'node server.js' && npm run dev",
    "dev:renderer": "next dev",
    "dev:electron": "electron .",
    "build:renderer": "next build",
    "build:main": "rimraf dist/main && tsc -p tsconfig.main.json",
    "build:preload": "rimraf dist/preload && tsc -p tsconfig.preload.json",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer && npm run postbuild",
    "clean": "rimraf dist",
    "clean:out": "rimraf out",
    "clean:all": "rimraf dist out .next .next-dev",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit --incremental false -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/index.test.ts",
    "test:db": "npm run build:main && node tests/run-db-smoke.cjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:db",
    "postbuild": "node -e \"const fs = require('fs'); fs.mkdirSync('dist/preload', { recursive: true }); fs.writeFileSync('dist/preload/package.json', JSON.stringify({ type: 'commonjs' })); fs.mkdirSync('dist/main', { recursive: true }); fs.writeFileSync('dist/main/package.json', JSON.stringify({ type: 'commonjs' }));\" && node scripts/postbuild-css.js",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "start": "electron-forge start",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:electron",
    "setup:python": "node setup-python.js",
    "setup:ffmpeg": "node setup-ffmpeg.js",
    "prebuild": "npm run rebuild:electron && npm run setup:python && npm run setup:ffmpeg",
    "premake": "npm run clean:out && npm run build",
    "package": "npm run build && electron-forge package",
    "make": "electron-forge make",
    "publish": "npm run build && electron-forge publish",
    "build:all": "npm run make",
    "export:renderer": "next build && next export -o dist/exported"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "bindings": "^1.5.0",
    "electron-is-dev": "^2.0.0",
    "electron-serve": "^1.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "file-uri-to-path": "^1.0.0",
    "framer-motion": "^14.7.1"
  },
  "browserslist": [
    "Chrome >= 120"
  ],
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-webpack": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron": "^1.6.12",
    "@types/node": "^20.19.20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "adm-zip": "^0.5.16",
    "assert": "^2.1.0",
    "autoprefixer": "^10.4.22",
    "browserify-zlib": "^0.2.0",
    "concurrently": "^9.2.1",
    "crypto-browserify": "^3.12.1",
    "cssnano": "^7.1.2",
    "electron": "^28.3.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "fs-extra": "^11.3.2",
    "https-browserify": "^1.0.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.7",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rimraf": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "url": "^0.11.4",
    "wait-on": "^9.0.1",
    "webpack": "^5.102.1"
  }
}
